# Server Configuration
PORT=3005
NODE_ENV="development"

# Database (Supabase / PostgreSQL)
# Supabase Pooler (Transaction Mode - Port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase Direct / Session (Port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Redis Cache (Optional for local dev)
REDIS_URL="redis://localhost:6379"

# JWT Authentication Secrets
JWT_SECRET="your_jwt_access_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"

# CORS Configuration (comma-separated origins)
CORS_ORIGIN="http://localhost:3000,https://websitemdptv.vercel.app"

# # ImageKit Cloud Storage & CDN
# IMAGEKIT_PUBLIC_KEY="public_your_imagekit_public_key"
# IMAGEKIT_PRIVATE_KEY="private_your_imagekit_private_key"
# IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"

# Google Drive (OAuth2)
GOOGLE_CLIENT_ID = "your_google_client_id"
GOOGLE_CLIENT_SECRET = "your_google_client_secret"
GOOGLE_REFRESH_TOKEN = "your_refresh_token"
GOOGLE_DRIVE_FOLDER_ID = ""