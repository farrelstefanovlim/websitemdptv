# ==============================================================================
# MDPTV Backend — Environment Configuration
# ==============================================================================
# Salin file ini menjadi .env pada direktori Backend:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=3005
NODE_ENV="development" # Options: development | production | test

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# DATABASE_URL: Koneksi utama dengan Transaction Pooler (Port 6543 untuk Supabase)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Koneksi langsung / Session Mode (Port 5432) untuk eksekusi migrasi Prisma
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 3. Redis Cache & Rate Limiting (Opsional)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 4. Authentication (JWT Secrets)
# ------------------------------------------------------------------------------
# Gunakan string acak dan aman (contoh: openssl rand -base64 32)
JWT_SECRET="ganti_dengan_jwt_access_secret_yang_sangat_rahasia_dan_aman"
JWT_REFRESH_SECRET="ganti_dengan_jwt_refresh_secret_yang_sangat_rahasia_dan_aman"

# ------------------------------------------------------------------------------
# 5. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Daftar origin frontend yang diizinkan (pisahkan dengan koma jika lebih dari satu)
CORS_ORIGIN="http://localhost:3000,https://websitemdptv.vercel.app"

# ------------------------------------------------------------------------------
# 6. ImageKit (Media Cloud Storage)
# ------------------------------------------------------------------------------
IMAGEKIT_PUBLIC_KEY="public_your_imagekit_public_key_here"
IMAGEKIT_PRIVATE_KEY="private_your_imagekit_private_key_here"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"


