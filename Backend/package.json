{
  "name": "bun-express-ddd-backend",
  "version": "1.0.0",
  "description": "Template backend Express.js dengan Bun menggunakan arsitektur Domain-Driven Design (DDD)",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "seed": "bun prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "build": "echo \"No build step required for Bun, just run bun src/index.ts\""
  },
  "keywords": [
    "bun",
    "express",
    "ddd",
    "domain-driven-design",
    "typescript",
    "clean-architecture"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/multer": "^2.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "imagekit": "^6.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.21.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "bun-types": "^1.1.8",
    "prisma": "^7.8.0",
    "typescript": "^5.4.5"
  }
}